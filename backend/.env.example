NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/khatu_shyam
APP_ORIGIN=http://127.0.0.1:5173

# Firebase Admin uses Application Default Credentials in AWS.
FIREBASE_PROJECT_ID=your-firebase-project-id

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_PLAN_ID=plan_replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

AWS_REGION=ap-south-1
S3_MEDIA_BUCKET=khatu-shyam-media-dev
CLOUDFRONT_BASE_URL=https://example.cloudfront.net
# Optional: absolute path to khatu-shyam-content for local static media
# MEDIA_LOCAL_ROOT=/absolute/path/to/khatu-shyam-content

# Comma-separated Google emails that become admins on login
ADMIN_EMAILS=you@example.com

# true = no paywall (all signed-in users get premium APIs). Set false for billing.
APP_FREE_MODE=true
